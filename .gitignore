# ========================================
# 通用编译输出
# ========================================
bin-debug/
bin-release/
[Bb]in/
[Oo]bj/
*.o
*.obj
*.d
*.crf
*.lst
*.map
*.axf
*.hex
*.bin
*.exe
*.swf
*.air
*.ipa
*.apk

# ========================================
# Keil 工程配置（每个人不同，禁止上传）
# ========================================
*.uvopt
*.uvoptx
*.uvgui
*.uvguix
*.scvd
*.uvguix.*
*.uvoptx.*
*.iex
*.sct
*.lnp

# ========================================
# 备份文件
# ========================================
*.bak
*.dep
*.log
*.tmp
*.ioc.bak

# ========================================
# 系统 / IDE 临时文件
# ========================================
.settings/
.vscode/
.vs/
.DS_Store
Thumbs.db
*.ipch
*.db
*.suo
*.user
*.local

# ========================================
# 打包 & 压缩文件（EDA 目录下的放行）
# ========================================
*.zip
*.rar
*.7z
# 放行 EDA 文件夹中的 Gerber 压缩包
!EDA/Gerber/*.zip

# ========================================
# 输出目录（Keil 默认输出路径）
# ========================================
/Output/
/Listings/
/Objects/
/DebugConfig/
/Debug/
/Release/
/build/

# ========================================
# STM32CubeMX 临时文件（如有）
# ========================================
*_CubeMX_Code/

# ========================================
# 其他项目 / 自定义目录
# ========================================
相关资料/
.相关资料/
*.sln
*.vcxproj
*.filters

# ========================================
# 注意：不忽略 .uvprojx / .uvproj 工程文件
# 不忽略 .c / .h 源文件
# ========================================